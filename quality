#!/usr/bin/env bash
# Thin wrapper so you can type `./quality` instead of `node scan.js`.
# Passes every argument straight through. Read-only — see scan.js.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v node >/dev/null 2>&1; then
  echo "error: Node.js not found on PATH. Install Node 18+ (20+ recommended): https://nodejs.org" >&2
  exit 2
fi
exec node "$DIR/scan.js" "$@"
